{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hardware-hub",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/u/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hardware-hub",
      "database_id": "7654e9ee-738e-4e4d-922c-69c70493b582",
      "migrations_dir": "db/migrations"
    }
  ],
  // Photo uploads need R2. Once it is enabled on the account, run
  // `npx wrangler r2 bucket create hardware-hub-uploads` and add:
  // "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "hardware-hub-uploads" }]
  "observability": { "enabled": true }
}
